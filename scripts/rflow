#!/usr/bin/env bash
# The deterministic steps of the rflow flows. Functions that print a value run inside $(...),
# where bash ignores set -e, so they fail through die.

set -euo pipefail

die() {
  echo "rflow: $*" >&2
  exit 1
}

usage() {
  die "usage: rflow sync | status | checks | settings <template> | docs | labels | open [--no-tracker] <type> <title...> | open pr <number|url> | open head <number|url> | close <branch> | close pr <number> | resolve [--not-planned] <issue> <file> | hotspots [commits] [count] | frontier <parent>"
}

# The main checkout's path, from the main checkout or any linked worktree.
main_checkout() {
  local path
  path=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  [ -n "$path" ] || die "not inside a git repository"
  echo "$path"
}

# The base branch every branch starts from and merges into: the branch the main checkout sits
# on, which must be origin's default branch when origin names one.
base_branch() {
  local main=$1 branch default
  branch=$(git -C "$main" branch --show-current)
  [ -n "$branch" ] || die "the main checkout has a detached HEAD; check out the default branch first"
  if default=$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
    default=${default#origin/}
    [ "$branch" = "$default" ] || die "the main checkout is on $branch; check out $default first"
  fi
  echo "$branch"
}

# ../.worktrees/<repo>-<name> beside the main checkout, with "/" in the name turned into "-".
worktree_path() {
  echo "$(dirname "$1")/.worktrees/$(basename "$1")-${2//\//-}"
}

# <branch>: the path of the worktree that has <branch> checked out, or nothing.
branch_worktree() {
  git worktree list --porcelain | awk -v ref="branch refs/heads/$1" '/^worktree /{wt = substr($0, 10)} $0 == ref {print wt}'
}

require_main_checkout() {
  [ "$(git rev-parse --show-toplevel)" = "$1" ] || die "run rflow flows from the main checkout at $1"
}

# <main>: the root of the current worktree, which must be one of <main>'s rflow worktrees.
worktree_root() {
  local top
  top=$(git rev-parse --show-toplevel)
  [[ $top == "$(dirname "$1")/.worktrees/"* ]] || die "$top is not an rflow worktree"
  echo "$top"
}

# <main> <require_tracker>: fast-forward the base branch from its upstream, then check that setup ran.
sync_base() {
  local base
  require_main_checkout "$1"
  base=$(base_branch "$1")
  if git rev-parse --quiet --verify "$base@{upstream}" >/dev/null; then
    git pull --quiet --ff-only >&2
  fi
  if $2 && [ ! -f "$1/docs/agents/issue-tracker.md" ]; then
    die "docs/agents/issue-tracker.md is missing; run /rflow:setup first, or merge its open pull request"
  fi
}

# <require_tracker> <type> <title...>
open_branch() {
  local require_tracker=$1 type=$2 name branch main path
  shift 2
  [[ $type =~ ^(feat|fix|docs|chore)$ ]] || die "type '$type' must be feat, fix, docs or chore"
  # A kebab-case slug of the title's first five words.
  name=$(printf '%s' "$*" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -d- -f1-5)
  [ -n "$name" ] || die "the title '$*' has no letters or digits to name a branch with"
  branch=$type/$name
  main=$(main_checkout)
  sync_base "$main" "$require_tracker"
  git worktree prune
  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    die "branch $branch already exists on origin"
  fi
  path=$(worktree_path "$main" "$branch")
  [ ! -e "$path" ] || die "$path already exists"
  git worktree add --quiet -b "$branch" "$path" HEAD >&2
  echo "$path"
}

# <number|url>: fetch the head GitHub publishes as refs/pull/<n>/head, which also serves fork pull requests.
open_pr() {
  local main number path
  main=$(main_checkout)
  require_main_checkout "$main"
  number=$(gh pr view "$1" --json number --jq .number)
  path=$(worktree_path "$main" "pr-$number")
  git worktree prune
  [ ! -e "$path" ] || die "$path already exists"
  git fetch --quiet origin "refs/pull/$number/head" >&2
  git worktree add --quiet --detach "$path" FETCH_HEAD >&2
  echo "$path"
}

# <number|url>: a worktree on a same-repo open pull request's own head branch, tracking origin,
# so commits made there push to that pull request.
open_head() {
  local main tracker pr number head base fork state path
  main=$(main_checkout)
  # An up-to-date base keeps other pull requests' trailers out of `rflow status`'s ref lines.
  sync_base "$main" false
  tracker=$main/docs/agents/issue-tracker.md
  # rflow:finish local-merges a branch when the tracker is not GitHub, which would skip the pull request.
  grep -qi github "$tracker" 2>/dev/null || die "$tracker does not name GitHub, so a change could not reach the pull request"
  pr=$(gh pr view "$1" --json number,headRefName,baseRefName,isCrossRepository,state \
    --jq '"\(.number) \(.headRefName) \(.baseRefName) \(.isCrossRepository) \(.state)"')
  read -r number head base fork state <<<"$pr"
  [ "$fork" = false ] || die "pull request #$number comes from a fork, whose branch rflow cannot push to"
  [ "$state" = OPEN ] || die "pull request #$number is $(echo "$state" | tr '[:upper:]' '[:lower:]'), so nothing would merge a change to it"
  [ "$base" = "$(base_branch "$main")" ] || die "pull request #$number targets $base, not $(base_branch "$main"), and rflow reviews against the default branch"
  git worktree prune
  git fetch --quiet origin "+refs/heads/$head:refs/remotes/origin/$head" >&2
  path=$(branch_worktree "$head")
  if [ -n "$path" ]; then
    [[ $path == "$(dirname "$main")/.worktrees/"* ]] ||
      die "$head is checked out at $path, outside rflow's worktrees; remove that worktree first"
    catch_up_head "$head" "$path"
  else
    path=$(worktree_path "$main" "$head")
    if git show-ref --verify --quiet "refs/heads/$head"; then
      catch_up_head "$head"
      git worktree add --quiet "$path" "$head" >&2
    else
      git worktree add --quiet --track -b "$head" "$path" "origin/$head" >&2
    fi
  fi
  echo "$path"
}

# <branch> [worktree]: keep the local branch's unpushed commits, catch it up to origin when behind,
# and set it tracking origin. A diverged branch is refused, since origin would reject its push.
catch_up_head() {
  if git merge-base --is-ancestor "$1" "origin/$1"; then
    if [ -n "${2:-}" ]; then
      git -C "$2" merge --quiet --ff-only "origin/$1" >&2
    else
      git branch --quiet --force "$1" "origin/$1"
    fi
  elif ! git merge-base --is-ancestor "origin/$1" "$1"; then
    die "local branch $1 has diverged from origin/$1; reconcile them before tweaking"
  fi
  git branch --quiet --set-upstream-to="origin/$1" "$1"
}

status() {
  local main top branch base
  main=$(main_checkout)
  top=$(worktree_root "$main")
  branch=$(git branch --show-current)
  [ -n "$branch" ] || die "$top has a detached HEAD"
  base=$(base_branch "$main")
  echo "base=$base"
  echo "main_checkout=$main"
  echo "branch=$branch"
  # rflow:finish skips shipping a branch with no commits beyond the base.
  echo "commits=$(git rev-list --count "$base..HEAD")"
  # One ref line per ticket or spec the branch implemented, recorded as commit trailers.
  git log "$base..HEAD" --format='%(trailers:key=Ticket,key=Spec,valueonly)' | sed '/^$/d' | sort -u | sed 's/^/ref=/'
}

# Right after `gh pr create`, CI has not registered its runs yet, and gh reports "no checks"
# exactly as it does for a repository without CI. Ask again for a minute before trusting it.
checks() {
  local out
  for _ in 1 2 3 4 5 6; do
    if out=$(gh pr checks 2>&1); then
      echo "$out"
      return
    fi
    case $out in
      *"no checks reported"*) sleep "${RFLOW_CHECKS_WAIT:-10}" ;;
      *) exec gh pr checks --watch ;;
    esac
  done
  echo "no checks reported on this branch; nothing to wait for"
}

# <template>: merges the template into the worktree's .claude/settings.json and prints the result.
# Keys the file already has stay, the template wins where both set a scalar, and an array keeps
# the file's entries and adds the template's missing ones after them, so a user's permission rules
# stay. A missing or empty file counts as {}. On any failure the file stays as it was.
merge_settings() {
  local template=$1 main top file old
  command -v jq >/dev/null || die "settings needs jq, which is not installed"
  main=$(main_checkout)
  top=$(worktree_root "$main")
  file=$top/.claude/settings.json
  old=$file
  [ -f "$old" ] || old=/dev/null
  mkdir -p "$top/.claude"
  jq -n --slurpfile old "$old" --slurpfile new "$template" '
    def union($a; $b):
      if ($a | type) == "object" and ($b | type) == "object" then
        reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = union($a[$k]; $b[$k]))
      elif ($a | type) == "array" and ($b | type) == "array" then $a + ($b - $a)
      else $b end;
    union($old[0] // {}; $new[0])' >"$file.tmp" || {
    rm -f "$file.tmp"
    die "could not merge $template into $file, which is left as it was"
  }
  mv "$file.tmp" "$file"
  cat "$file"
}

# Creates the shared docs scaffold in the current worktree: docs/research/ for
# research notes, docs/adr/ for the domain-modeling flow's decisions, and docs/misc/
# for documents that fit nowhere else. Only a missing README is written, printed as
# "created <path>"; every existing file stays.
scaffold_docs() {
  local main top dir file header body
  main=$(main_checkout)
  top=$(worktree_root "$main")
  for dir in research adr misc; do
    case $dir in
      research) header='# Research notes' body='One file per topic. Flows reference them through context pointers.' ;;
      adr) header='# ADRs' body='Architecture decision records, one per file, named NNNN-slug.md. The domain-modeling flow creates them here.' ;;
      misc) header='# Misc' body='Documents that fit nowhere else in docs/.' ;;
    esac
    mkdir -p "$top/docs/$dir"
    file=$top/docs/$dir/README.md
    if [ -f "$file" ]; then
      continue
    fi
    printf '%s\n\n%s\n' "$header" "$body" >"$file"
    echo "created docs/$dir/README.md"
  done
}

# <checkout>: stops unless the checkout's tracker doc names GitHub, so nothing lands on GitHub
# for a repo tracked elsewhere.
require_github() {
  local tracker=$1/docs/agents/issue-tracker.md
  grep -qi github "$tracker" 2>/dev/null || die "$tracker does not name GitHub, and this command works only with GitHub"
}

# <reason> <issue> <file>: posts the file as a comment on the issue, then closes it with <reason>.
resolve_issue() {
  local reason=$1 issue=$2 file=$3 number state
  require_github "$(main_checkout)"
  [ -s "$file" ] || die "$file is missing or empty, so there is no resolution comment to post"
  read -r number state <<<"$(gh issue view "$issue" --json number,state --jq '"\(.number) \(.state)"')"
  [ "$state" = OPEN ] || die "issue #$number is already closed"
  gh issue comment "$issue" --body-file "$file" >&2
  gh issue close "$issue" --reason "$reason" >&2
}

# Creates each label rflow applies that the repo lacks, printed as "created <label>". Existing
# labels keep their colours and descriptions, since gh refuses to create a label twice without --force.
create_labels() {
  local existing label
  # The current worktree's tracker doc, since setup writes it there before it reaches the main checkout.
  require_github "$(git rev-parse --show-toplevel)"
  existing=$(gh label list --limit 1000 --json name --jq '.[].name')
  for label in wayfinder:map wayfinder:research wayfinder:prototype wayfinder:grilling wayfinder:task \
    bug enhancement ready-for-agent; do
    if ! grep -qxF -- "$label" <<<"$existing"; then
      gh label create "$label" >&2
      echo "created $label"
    fi
  done
}

# Deletes the branch only when each of its commits is on the base branch or its upstream.
close_branch() {
  local branch=$1 main base upstream path
  main=$(main_checkout)
  cd "$main"
  git show-ref --verify --quiet "refs/heads/$branch" || die "branch $branch does not exist"
  base=$(base_branch "$main")
  upstream=$(git rev-parse --abbrev-ref --quiet "$branch@{upstream}" 2>/dev/null) || upstream=$base
  [ "$(git rev-list --count "$branch" --not "$base" "$upstream")" -eq 0 ] ||
    die "$branch has commits that are on neither $base nor its upstream; kept its worktree and branch"
  path=$(branch_worktree "$branch")
  [ -z "$path" ] || git worktree remove "$path"
  git branch --quiet -D "$branch"
  echo "removed ${path:+$path and }branch $branch"
}

close_pr() {
  local main path
  [[ $1 =~ ^[0-9]+$ ]] || die "close pr takes a pull request number, not '$1'"
  main=$(main_checkout)
  cd "$main"
  path=$(worktree_path "$main" "pr-$1")
  git worktree remove "$path"
  echo "removed $path"
}

# <commits> <count>: prints the <count> files changed in the most of the current branch's last
# <commits> commits, most first and ties in path order. Only files still in HEAD count. awk cuts
# the list rather than head, whose early exit would fail the pipeline under pipefail.
hotspots() {
  [[ $1 =~ ^[1-9][0-9]*$ && $2 =~ ^[1-9][0-9]*$ ]] || usage
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
  git rev-parse --verify --quiet HEAD >/dev/null || die "no commits yet"
  git -c core.quotePath=false log -n "$1" --format= --name-only |
    awk -v tree=<(git -c core.quotePath=false ls-tree -r --name-only --full-tree HEAD) '
      BEGIN { while ((getline f < tree) > 0) live[f] }
      $0 in live { n[$0]++ }
      END { for (f in n) printf "%d\t%s\n", n[f], f }' |
    LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2 | cut -f2- | awk -v max="$2" 'NR <= max'
}

# <parent>: prints open=<n>, the count of the parent issue's open sub-issues, then a
# "<number> <type>" line per open one with no open blocker and no assignee, in sub-issue order.
# --jq runs once per page and prints "<state> <free> <number> <type>" per sub-issue. The pages
# are read in full before counting, so a failed call never prints open=0.
frontier() {
  local children
  [[ $1 =~ ^[0-9]+$ ]] || die "frontier takes a parent issue number, not '$1'"
  children=$(gh api --paginate "repos/{owner}/{repo}/issues/$1/sub_issues" --jq '.[] |
    "\(.state) \(.issue_dependencies_summary.blocked_by == 0 and (.assignees | length) == 0) \(.number) \(
      first(.labels[].name | select(startswith("wayfinder:")) | ltrimstr("wayfinder:")) // "-")"')
  awk '$1 == "open" { n++ } $1 == "open" && $2 == "true" { lines = lines $3 " " $4 "\n" }
    END { printf "open=%d\n%s", n, lines }' <<<"$children"
}

case "${1:-} ${2:-}" in
  "sync ") main=$(main_checkout); sync_base "$main" true ;;
  "status ") status ;;
  "checks ") checks ;;
  "settings "*) [ $# -eq 2 ] || usage; merge_settings "$2" ;;
  "docs ") scaffold_docs ;;
  "labels ") create_labels ;;
  "open pr") [ $# -eq 3 ] || usage; open_pr "$3" ;;
  "open head") [ $# -eq 3 ] || usage; open_head "$3" ;;
  "open --no-tracker") [ $# -ge 4 ] || usage; open_branch false "${@:3}" ;;
  "open "*) [ $# -ge 3 ] || usage; open_branch true "${@:2}" ;;
  "close pr") [ $# -eq 3 ] || usage; close_pr "$3" ;;
  "close "*) [ $# -eq 2 ] || usage; close_branch "$2" ;;
  "resolve --not-planned") [ $# -eq 4 ] || usage; resolve_issue "not planned" "$3" "$4" ;;
  "resolve "*) [ $# -eq 3 ] || usage; resolve_issue completed "$2" "$3" ;;
  "hotspots "*) [ $# -le 3 ] || usage; hotspots "${2:-100}" "${3:-20}" ;;
  "frontier "*) [ $# -eq 2 ] || usage; frontier "$2" ;;
  *) usage ;;
esac
